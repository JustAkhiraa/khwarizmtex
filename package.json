{
  "name": "khwarizmtex",
  "version": "0.1.0",
  "description": "Rendu de formules mathématiques soigné, rapide et sans dépendance, pour le serveur comme pour le navigateur.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./khwarizm.css": "./dist/khwarizm.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:css": "node scripts/build-css.mjs",
    "build": "node scripts/build-css.mjs && tsup",
    "test": "node scripts/build-css.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "node scripts/bench.mjs"
  },
  "keywords": [
    "math",
    "formules",
    "mathematiques",
    "rendu",
    "accessibilite",
    "ssr"
  ],
  "dependencies": {},
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0"
}
